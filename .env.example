# ─────────────────────────────────────────────
# 复制本文件为 .env.local，填入你自己的凭据
#   cp .env.example .env.local
# .env.local 已被 .gitignore 忽略，不会提交
# ─────────────────────────────────────────────

# 【必填】知乎开放平台 Access Secret
# 获取：https://developer.zhihu.com/ → 控制台 → 应用管理
# 用途：调用知乎搜索 API 挂载真实经验；未配置通用模型时也用于知乎直答
ZHIHU_ACCESS_SECRET=

# 【可选】通用模型凭据
# 留空则自动回退到知乎直答（注意：直答免费额度仅 2 次/天，开发时容易用完）
# 建议填写，开发体验好很多
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=deepseek-v4.1-flash-1017
